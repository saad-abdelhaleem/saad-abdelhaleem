# Cloudflare Workers static-assets headers (replaces vercel.json)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Asset filenames are not content-hashed, so cache for a day and revalidate
# in the background instead of marking them immutable.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
